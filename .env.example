# Copy to .env and adjust.
OLLAMA_MODEL=qwen3-coder:30b
# Container reaches host Ollama via host.docker.internal
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=ollama
# Check https://docs.openhands.dev for current tags; keep both on the same version.
OPENHANDS_VERSION=latest
RUNTIME_VERSION=latest-nikolaik
OPENHANDS_PORT=3000
