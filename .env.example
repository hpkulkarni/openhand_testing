# Copy to .env and adjust.
OLLAMA_MODEL=qwen3-coder:30b
# Container reaches host Ollama via host.docker.internal
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=ollama
# Pinned by digest (the build verified working locally). The app can control the host's
# Docker via the mounted socket, so upgrade deliberately: pull, test, then update this digest.
# Check https://docs.openhands.dev for release tags; keep both images on the same version.
OPENHANDS_VERSION=latest@sha256:17d0648956f9c181ca4ee18bd8e87a6e1bc1ddeee3862395a92bdb33d38653c8
RUNTIME_VERSION=latest-nikolaik
OPENHANDS_PORT=3000
